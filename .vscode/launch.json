{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/../varn-lang/tests"
            ],
            "outFiles": [
                "${workspaceFolder}/extension.js",
                "${workspaceFolder}/src/**/*.js"
            ],
            "env": {
                "PATH": "${workspaceFolder}\\..\\varn-lang\\target\\debug;${workspaceFolder}\\..\\varn-lang\\target\\release;${env:PATH}"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
