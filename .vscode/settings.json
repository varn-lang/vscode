{
    "vn.buildMode": "debug",
    "vn.codeLens.enabled": true,
    "editor.semanticHighlighting.enabled": true,
    "[vn]": {
        "editor.semanticHighlighting.enabled": true
    },
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/target/**": true
    },
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "keyword": "#c678dd",
            "keyword.operator": "#56B6C2"
        }
    }
}
