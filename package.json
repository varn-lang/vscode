{
  "name": "vn-language",
  "displayName": "Varn Language Support",
  "description": "Syntax highlighting, diagnostics, hover, go-to-definition, completions, rename, run and debug for the Varn language.",
  "version": "0.3.3",
  "publisher": "Varn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/varn-lang/vscode"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "build": "pnpm run typecheck && pnpm run check:manifest && pnpm run check:naming && pnpm run grammar:snapshot && pnpm run bundle && vsce package --no-dependencies --allow-missing-repository",
    "grammar:scan": "node scripts/scan-grammar.cjs",
    "smoke": "node scripts/smoke-load.cjs",
    "typecheck": "tsc -p .",
    "check:manifest": "node scripts/check-manifest.cjs",
    "scan:tests": "node scripts/check-test-scan.mjs",
    "check:naming": "node scripts/check-naming.cjs",
    "test:integration": "pnpm run bundle && node scripts/run-integration.mjs",
    "grammar:snapshot": "node scripts/check-grammar-snapshots.cjs",
    "grammar:lexer": "node scripts/check-grammar-lexer.cjs",
    "semantic:coverage": "node scripts/check-semantic-coverage.cjs"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace Varn does not run binaries found inside the workspace and ignores a workspace-level vn.cli.path.",
      "restrictedConfigurations": [
        "vn.cli.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Varn runs the vn binary against files on disk, so virtual file systems are not supported."
    }
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Themes"
  ],
  "activationEvents": [
    "onLanguage:vn"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vn-sidebar",
          "title": "Varn",
          "icon": "icons/vn-activity.svg"
        }
      ]
    },
    "views": {
      "vn-sidebar": [
        {
          "id": "vn-status",
          "name": "Status & Environment",
          "contextualTitle": "Varn"
        },
        {
          "id": "vn-actions",
          "name": "Quick Actions",
          "contextualTitle": "Varn"
        },
        {
          "id": "vn-ast",
          "name": "AST Explorer",
          "contextualTitle": "Varn"
        }
      ]
    },
    "languages": [
      {
        "id": "vn",
        "aliases": [
          "Varn",
          "vn"
        ],
        "extensions": [
          ".vn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vn",
        "scopeName": "source.vn",
        "path": "./syntaxes/vn.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vn",
        "scopes": {
          "type": [
            "entity.name.type",
            "support.type.primitive.vn"
          ],
          "class": [
            "entity.name.type.class",
            "support.class.vn"
          ],
          "variable": [
            "variable.other.readwrite.vn"
          ],
          "parameter": [
            "variable.parameter.vn"
          ],
          "property": [
            "variable.other.property.vn"
          ],
          "function": [
            "entity.name.function.vn"
          ],
          "enumMember": [
            "variable.other.enummember.vn"
          ],
          "namespace": [
            "entity.name.namespace.vn"
          ],
          "interface": [
            "entity.name.type.interface.vn"
          ],
          "typeParameter": [
            "entity.name.type.parameter.vn"
          ],
          "keyword": [
            "keyword.control.vn",
            "keyword.other.vn"
          ],
          "number": [
            "constant.numeric.vn",
            "constant.language.vn"
          ],
          "string": [
            "string.quoted.vn"
          ],
          "variable.readonly": [
            "variable.other.constant.vn"
          ],
          "property.readonly": [
            "variable.other.constant.property.vn"
          ],
          "function.static": [
            "entity.name.function.static.vn",
            "entity.name.function.vn"
          ],
          "property.static": [
            "variable.other.property.static.vn",
            "variable.other.property.vn"
          ],
          "method": [
            "entity.name.function.method.vn",
            "entity.name.function.vn"
          ],
          "enum": [
            "entity.name.type.enum.vn",
            "entity.name.type.vn"
          ],
          "decorator": [
            "entity.name.function.decorator.vn",
            "meta.decorator.vn"
          ],
          "regexp": [
            "string.regexp.vn"
          ],
          "*.defaultLibrary": [
            "support.function.builtin.vn"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.vn"
          ],
          "*.deprecated": [
            "invalid.deprecated.vn"
          ]
        }
      }
    ],
    "iconThemes": [
      {
        "id": "vn-icons",
        "label": "Varn Icons",
        "path": "./icons/vn-icons.json"
      }
    ],
    "debuggers": [
      {
        "type": "vn",
        "label": "Varn Debug",
        "languages": [
          "vn"
        ],
        "initialConfigurations": [
          {
            "type": "vn",
            "request": "launch",
            "name": "Debug Varn File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Varn: Debug file",
            "description": "Debug the current Varn file with breakpoints and stepping",
            "body": {
              "type": "vn",
              "request": "launch",
              "name": "Debug Varn File",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "Varn: Debug file (stop on entry)",
            "description": "Debug the current Varn file, stopping on program entry",
            "body": {
              "type": "vn",
              "request": "launch",
              "name": "Debug Varn File (entry)",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .vn file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on program entry.",
                "default": false
              }
            }
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "vn.bytecode",
        "displayName": "Varn Bytecode",
        "selector": [
          {
            "filenamePattern": "*.vn"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "vn.ssa",
        "displayName": "Varn SSA",
        "selector": [
          {
            "filenamePattern": "*.vn"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vn.restartServer",
        "title": "Restart Language Server",
        "category": "Varn"
      },
      {
        "command": "vn.stopServer",
        "title": "Stop Language Server",
        "category": "Varn"
      },
      {
        "command": "vn.showServerLog",
        "title": "Show Language Server Log",
        "category": "Varn"
      },
      {
        "command": "vn.showLog",
        "title": "Show Extension Log",
        "category": "Varn"
      },
      {
        "command": "vn.runFile",
        "title": "Run File",
        "category": "Varn",
        "icon": "$(play)"
      },
      {
        "command": "vn.runFileInTerminal",
        "title": "Run File in Terminal",
        "category": "Varn",
        "icon": "$(terminal)"
      },
      {
        "command": "vn.checkFile",
        "title": "Check File (Typecheck)",
        "category": "Varn",
        "icon": "$(checklist)"
      },
      {
        "command": "vn.buildFile",
        "title": "Build File (Compile)",
        "category": "Varn",
        "icon": "$(package)"
      },
      {
        "command": "vn.showBytecode",
        "title": "Show Bytecode",
        "category": "Varn",
        "icon": "$(file-binary)"
      },
      {
        "command": "vn.showAst",
        "title": "Show AST",
        "category": "Varn",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "vn.showTokens",
        "title": "Show Tokens",
        "category": "Varn"
      },
      {
        "command": "vn.benchFile",
        "title": "Benchmark File",
        "category": "Varn",
        "icon": "$(dashboard)"
      },
      {
        "command": "vn.runRepl",
        "title": "Start Interactive REPL",
        "category": "Varn",
        "icon": "$(terminal)"
      },
      {
        "command": "vn.pkgInstall",
        "title": "Pkg: Install Dependencies",
        "category": "Varn",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vn.pkgUpdate",
        "title": "Pkg: Update Dependencies",
        "category": "Varn",
        "icon": "$(refresh)"
      },
      {
        "command": "vn.pkgAdd",
        "title": "Pkg: Add Dependency",
        "category": "Varn",
        "icon": "$(add)"
      },
      {
        "command": "vn.pkgRemove",
        "title": "Pkg: Remove Dependency",
        "category": "Varn",
        "icon": "$(trash)"
      },
      {
        "command": "vn.cacheClean",
        "title": "Clean Cache",
        "category": "Varn",
        "icon": "$(clear-all)"
      },
      {
        "command": "vn.initProject",
        "title": "Init Project",
        "category": "Varn",
        "icon": "$(new-folder)"
      },
      {
        "command": "vn.doctor",
        "title": "Doctor (Check Setup)",
        "category": "Varn",
        "icon": "$(pulse)"
      },
      {
        "command": "vn.installRuntime",
        "title": "Install Runtime",
        "category": "Varn",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vn.runWithPhases",
        "title": "Run with Debug Phases...",
        "category": "Varn",
        "icon": "$(debug-console)"
      },
      {
        "command": "vn.toggleBuildMode",
        "title": "Toggle Build Mode (Debug/Release)",
        "category": "Varn"
      },
      {
        "command": "vn.reloadExtension",
        "title": "Reload Extension",
        "category": "Varn",
        "icon": "$(refresh)"
      },
      {
        "command": "vn.showActionsHub",
        "title": "Show Actions Hub",
        "category": "Varn",
        "icon": "$(symbol-menu)"
      },
      {
        "command": "vn.selectEditorRange",
        "title": "Select Editor Range"
      },
      {
        "command": "vn.openBytecodeViewer",
        "title": "Open Bytecode Viewer (Side-by-Side)",
        "category": "Varn",
        "icon": "$(file-binary)"
      },
      {
        "command": "vn.openSSAViewer",
        "title": "Open SSA Viewer (Side-by-Side)",
        "category": "Varn",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "vn.openVisualInspector",
        "title": "Open Graphical CFG & Debug Inspector",
        "category": "Varn",
        "icon": "$(graph)"
      },
      {
        "command": "vn.diffBytecode",
        "title": "Diff Source vs Bytecode",
        "category": "Varn",
        "icon": "$(diff)"
      },
      {
        "command": "vn.openStdModule",
        "title": "Open Stdlib Module (readonly)",
        "category": "Varn",
        "icon": "$(library)"
      },
      {
        "command": "vn.runMain",
        "title": "Run Main Function",
        "category": "Varn",
        "icon": "$(play)"
      },
      {
        "command": "vn.runTest",
        "title": "Run Test",
        "category": "Varn",
        "icon": "$(beaker)"
      },
      {
        "command": "vn.runBenchmark",
        "title": "Run Benchmark",
        "category": "Varn",
        "icon": "$(dashboard)"
      },
      {
        "command": "vn.openInstallGuide",
        "title": "Open Install Guide",
        "category": "Varn",
        "icon": "$(book)"
      },
      {
        "command": "vn.openWalkthrough",
        "title": "Get Started",
        "category": "Varn",
        "icon": "$(rocket)"
      }
    ],
    "problemMatchers": [
      {
        "name": "vn",
        "owner": "vn",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "vn",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The vn task to execute (build, check, test)"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "vn.runFile",
        "key": "ctrl+f5",
        "when": "resourceLangId == vn && !inDebugMode"
      },
      {
        "command": "workbench.action.debug.start",
        "key": "f5",
        "when": "resourceLangId == vn && !inDebugMode && !debuggersAvailable"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "vn.runFile",
          "when": "resourceLangId == vn",
          "group": "navigation@1"
        },
        {
          "command": "vn.runFileInTerminal",
          "when": "resourceLangId == vn",
          "group": "navigation@2"
        },
        {
          "command": "vn.checkFile",
          "when": "resourceLangId == vn",
          "group": "navigation@3"
        },
        {
          "command": "vn.buildFile",
          "when": "resourceLangId == vn",
          "group": "navigation@4"
        },
        {
          "command": "vn.runWithPhases",
          "when": "resourceLangId == vn",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "vn.runFile",
          "when": "resourceLangId == vn",
          "group": "vn@1"
        },
        {
          "command": "vn.runFileInTerminal",
          "when": "resourceLangId == vn",
          "group": "vn@2"
        },
        {
          "command": "vn.checkFile",
          "when": "resourceLangId == vn",
          "group": "vn@3"
        },
        {
          "command": "vn.buildFile",
          "when": "resourceLangId == vn",
          "group": "vn@4"
        },
        {
          "command": "vn.showBytecode",
          "when": "resourceLangId == vn",
          "group": "vn@5"
        },
        {
          "command": "vn.showAst",
          "when": "resourceLangId == vn",
          "group": "vn@6"
        },
        {
          "command": "vn.doctor",
          "when": "resourceLangId == vn",
          "group": "vn@7"
        },
        {
          "command": "vn.openVisualInspector",
          "when": "resourceLangId == vn",
          "group": "vn@8"
        }
      ],
      "editor/title": [
        {
          "command": "vn.openVisualInspector",
          "when": "resourceLangId == vn",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "vn.runFile",
          "when": "resourceExtname == .vn",
          "group": "vn@1"
        },
        {
          "command": "vn.runFileInTerminal",
          "when": "resourceExtname == .vn",
          "group": "vn@2"
        },
        {
          "command": "vn.checkFile",
          "when": "resourceExtname == .vn",
          "group": "vn@3"
        },
        {
          "command": "vn.buildFile",
          "when": "resourceExtname == .vn",
          "group": "vn@4"
        },
        {
          "command": "vn.benchFile",
          "when": "resourceExtname == .vn",
          "group": "vn@5"
        }
      ],
      "commandPalette": [
        {
          "command": "vn.selectEditorRange",
          "when": "false"
        },
        {
          "command": "vn.runFile",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.runFileInTerminal",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.checkFile",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.buildFile",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.showBytecode",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.showAst",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.showTokens",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.benchFile",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.runWithPhases",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.openBytecodeViewer",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.openSSAViewer",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.openVisualInspector",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.diffBytecode",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.runTest",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.runBenchmark",
          "when": "editorLangId == vn"
        },
        {
          "command": "vn.runMain",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Varn",
      "properties": {
        "vn.cli.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the `vn` binary. Leave empty to auto-detect: the VN_CLI_PATH environment variable, VN_HOME/bin, target/{release,debug,quick} of the workspace or of a sibling varn-lang checkout, or PATH.",
          "scope": "machine-overridable"
        },
        "vn.server.restartOnRebuild": {
          "type": "boolean",
          "default": true,
          "description": "Restart the language server when a `vn` binary built under a target directory is rebuilt, so development of the compiler and of the extension never block each other.",
          "scope": "machine-overridable"
        },
        "vn.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints for types and parameter names."
        },
        "vn.run.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Pass --verbose to `vn` when running files."
        },
        "vn.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Varn CodeLens actions (Run, Bench, Disasm, AST) at the top of .vn files."
        },
        "vn.hotReload.watchBinary": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restart the Language Server when the resolved `vn` binary is rebuilt."
        },
        "vn.buildMode": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "default": "release",
          "description": "Preferred build mode for `vn` binaries when auto-detecting from the workspace target directory."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "vn-actions",
        "contents": "The `vn` binary was not found, so Varn cannot run, check or build your code.\n[Open Install Guide](command:vn.openInstallGuide)\n[Set vn.cli.path](command:workbench.action.openSettings?%5B%22vn.cli.path%22%5D)\nAfter installing, the actions appear here."
      }
    ],
    "walkthroughs": [
      {
        "id": "vn.getStarted",
        "title": "Get Started with Varn",
        "description": "Install Varn, run a file, inspect the compiler output and debug.",
        "steps": [
          {
            "id": "vn.install",
            "title": "Install Varn",
            "description": "The extension drives the `vn` program.\n[Open Install Guide](command:vn.openInstallGuide)\n[Set vn.cli.path](command:workbench.action.openSettings?%5B%22vn.cli.path%22%5D)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onCommand:vn.openInstallGuide",
              "onSettingChanged:vn.cli.path"
            ]
          },
          {
            "id": "vn.create",
            "title": "Start a project",
            "description": "Create a `vn.toml` and a first file.\n[Init Project](command:vn.initProject)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:vn.initProject",
              "onLanguage:vn"
            ]
          },
          {
            "id": "vn.run",
            "title": "Run a file",
            "description": "Run the open `.vn` file and read its output.\n[Run File](command:vn.runFile)\n[Run File in Terminal](command:vn.runFileInTerminal)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:vn.runFile",
              "onCommand:vn.runFileInTerminal"
            ]
          },
          {
            "id": "vn.check",
            "title": "Check types",
            "description": "Type-check without running.\n[Check File](command:vn.checkFile)",
            "media": {
              "markdown": "media/walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:vn.checkFile"
            ]
          },
          {
            "id": "vn.inspect",
            "title": "See what the compiler makes",
            "description": "Bytecode, SSA, the control-flow graph and the standard library.\n[Show Bytecode](command:vn.showBytecode)\n[Open Bytecode Viewer](command:vn.openBytecodeViewer)",
            "media": {
              "markdown": "media/walkthrough/inspect.md"
            },
            "completionEvents": [
              "onCommand:vn.showBytecode",
              "onCommand:vn.openBytecodeViewer"
            ]
          },
          {
            "id": "vn.debug",
            "title": "Debug",
            "description": "Set a breakpoint and press F5.\n[Open Run and Debug](command:workbench.view.debug)",
            "media": {
              "markdown": "media/walkthrough/debug.md"
            },
            "completionEvents": [
              "onDebugStart"
            ]
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[vn]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "parameter:vn": {
            "underline": true
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "variable.parameter.vn",
            "settings": {
              "fontStyle": "underline"
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.109.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
