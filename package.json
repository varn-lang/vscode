{
  "name": "varn-language",
  "displayName": "Varn Language Support",
  "description": "Syntax highlighting, diagnostics, hover, go-to-definition, completions, rename, run and debug for the Varn language.",
  "version": "0.3.1",
  "publisher": "Varn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/varn-lang/vscode"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "build": "pnpm run typecheck && pnpm run bundle && vsce package --no-dependencies --allow-missing-repository",
    "grammar:scan": "node scripts/scan-grammar.cjs",
    "smoke": "node scripts/smoke-load.cjs",
    "typecheck": "tsc -p ."
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Themes"
  ],
  "activationEvents": [
    "onLanguage:varn",
    "onCommand:Varn.restartServer",
    "onCommand:Varn.stopServer",
    "onCommand:Varn.showServerLog",
    "onCommand:Varn.runFile",
    "onCommand:Varn.runFileInTerminal",
    "onCommand:Varn.runMain",
    "onCommand:Varn.runTest",
    "onCommand:Varn.runBenchmark",
    "onCommand:Varn.checkFile",
    "onCommand:Varn.buildFile",
    "onCommand:Varn.showBytecode",
    "onCommand:Varn.showAst",
    "onCommand:Varn.showTokens",
    "onCommand:Varn.benchFile",
    "onCommand:Varn.runRepl",
    "onCommand:Varn.pkgInstall",
    "onCommand:Varn.pkgUpdate",
    "onCommand:Varn.pkgAdd",
    "onCommand:Varn.pkgRemove",
    "onCommand:Varn.cacheClean",
    "onCommand:Varn.initProject",
    "onCommand:Varn.doctor",
    "onCommand:Varn.installRuntime",
    "onCommand:Varn.runWithPhases",
    "onCommand:Varn.toggleBuildMode",
    "onCommand:Varn.reloadExtension",
    "onCommand:Varn.showActionsHub",
    "onCommand:varn.openBytecodeViewer",
    "onCommand:varn.openSSAViewer",
    "onCommand:varn.diffBytecode",
    "onCommand:varn.openStdModule",
    "onCommand:varn.openVisualInspector"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "varn-sidebar",
          "title": "Varn",
          "icon": "icons/varn-activity.svg"
        }
      ]
    },
    "views": {
      "varn-sidebar": [
        {
          "id": "varn-status",
          "name": "Status & Environment",
          "contextualTitle": "Varn"
        },
        {
          "id": "varn-actions",
          "name": "Quick Actions",
          "contextualTitle": "Varn"
        },
        {
          "id": "varn-ast",
          "name": "AST Explorer",
          "contextualTitle": "Varn"
        }
      ]
    },
    "languages": [
      {
        "id": "varn",
        "aliases": [
          "Varn",
          "varn",
          "vn"
        ],
        "extensions": [
          ".vn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "varn",
        "scopeName": "source.vn",
        "path": "./syntaxes/vn.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "varn",
        "scopes": {
          "type": [
            "entity.name.type",
            "support.type.primitive.vn"
          ],
          "class": [
            "entity.name.type.class",
            "support.class.vn"
          ],
          "variable": [
            "variable.other.readwrite.vn"
          ],
          "parameter": [
            "variable.parameter.vn"
          ],
          "property": [
            "variable.other.property.vn"
          ],
          "function": [
            "entity.name.function.vn"
          ],
          "enumMember": [
            "variable.other.enummember.vn"
          ],
          "namespace": [
            "entity.name.namespace.vn"
          ],
          "interface": [
            "entity.name.type.interface.vn"
          ],
          "typeParameter": [
            "entity.name.type.parameter.vn"
          ]
        }
      }
    ],
    "iconThemes": [
      {
        "id": "varn-icons",
        "label": "Varn Icons",
        "path": "./icons/varn-icons.json"
      }
    ],
    "debuggers": [
      {
        "type": "Varn",
        "label": "Varn Debug",
        "languages": [
          "varn"
        ],
        "initialConfigurations": [
          {
            "type": "Varn",
            "request": "launch",
            "name": "Debug Varn File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Varn: Debug file",
            "description": "Debug the current Varn file with breakpoints and stepping",
            "body": {
              "type": "Varn",
              "request": "launch",
              "name": "Debug Varn File",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "Varn: Debug file (stop on entry)",
            "description": "Debug the current Varn file, stopping on program entry",
            "body": {
              "type": "Varn",
              "request": "launch",
              "name": "Debug Varn File (entry)",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .vn file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on program entry.",
                "default": false
              }
            }
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "varn.bytecode",
        "displayName": "Varn Bytecode",
        "selector": [
          {
            "filenamePattern": "*.vn"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "varn.ssa",
        "displayName": "Varn SSA",
        "selector": [
          {
            "filenamePattern": "*.vn"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "Varn.restartServer",
        "title": "Restart Language Server",
        "category": "Varn"
      },
      {
        "command": "Varn.stopServer",
        "title": "Stop Language Server",
        "category": "Varn"
      },
      {
        "command": "Varn.showServerLog",
        "title": "Show Language Server Log",
        "category": "Varn"
      },
      {
        "command": "Varn.runFile",
        "title": "Run File",
        "category": "Varn",
        "icon": "$(play)"
      },
      {
        "command": "Varn.runFileInTerminal",
        "title": "Run File in Terminal",
        "category": "Varn",
        "icon": "$(terminal)"
      },
      {
        "command": "Varn.checkFile",
        "title": "Check File (Typecheck)",
        "category": "Varn",
        "icon": "$(checklist)"
      },
      {
        "command": "Varn.buildFile",
        "title": "Build File (Compile)",
        "category": "Varn",
        "icon": "$(package)"
      },
      {
        "command": "Varn.showBytecode",
        "title": "Show Bytecode",
        "category": "Varn",
        "icon": "$(file-binary)"
      },
      {
        "command": "Varn.showAst",
        "title": "Show AST",
        "category": "Varn",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "Varn.showTokens",
        "title": "Show Tokens",
        "category": "Varn"
      },
      {
        "command": "Varn.benchFile",
        "title": "Benchmark File",
        "category": "Varn",
        "icon": "$(dashboard)"
      },
      {
        "command": "Varn.runRepl",
        "title": "Start Interactive REPL",
        "category": "Varn",
        "icon": "$(terminal)"
      },
      {
        "command": "Varn.pkgInstall",
        "title": "Pkg: Install Dependencies",
        "category": "Varn",
        "icon": "$(cloud-download)"
      },
      {
        "command": "Varn.pkgUpdate",
        "title": "Pkg: Update Dependencies",
        "category": "Varn",
        "icon": "$(refresh)"
      },
      {
        "command": "Varn.pkgAdd",
        "title": "Pkg: Add Dependency",
        "category": "Varn",
        "icon": "$(add)"
      },
      {
        "command": "Varn.pkgRemove",
        "title": "Pkg: Remove Dependency",
        "category": "Varn",
        "icon": "$(trash)"
      },
      {
        "command": "Varn.cacheClean",
        "title": "Clean Cache",
        "category": "Varn",
        "icon": "$(clear-all)"
      },
      {
        "command": "Varn.initProject",
        "title": "Init Project",
        "category": "Varn",
        "icon": "$(new-folder)"
      },
      {
        "command": "Varn.doctor",
        "title": "Doctor (Check Setup)",
        "category": "Varn",
        "icon": "$(pulse)"
      },
      {
        "command": "Varn.installRuntime",
        "title": "Install Runtime",
        "category": "Varn",
        "icon": "$(cloud-download)"
      },
      {
        "command": "Varn.runWithPhases",
        "title": "Run with Debug Phases...",
        "category": "Varn",
        "icon": "$(debug-console)"
      },
      {
        "command": "Varn.toggleBuildMode",
        "title": "Toggle Build Mode (Debug/Release)",
        "category": "Varn"
      },
      {
        "command": "Varn.reloadExtension",
        "title": "Reload Extension",
        "category": "Varn",
        "icon": "$(refresh)"
      },
      {
        "command": "Varn.showActionsHub",
        "title": "Show Actions Hub",
        "category": "Varn",
        "icon": "$(symbol-menu)"
      },
      {
        "command": "Varn.selectEditorRange",
        "title": "Select Editor Range"
      },
      {
        "command": "varn.openBytecodeViewer",
        "title": "Open Bytecode Viewer (Side-by-Side)",
        "category": "Varn",
        "icon": "$(file-binary)"
      },
      {
        "command": "varn.openSSAViewer",
        "title": "Open SSA Viewer (Side-by-Side)",
        "category": "Varn",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "varn.openVisualInspector",
        "title": "Open Graphical CFG & Debug Inspector",
        "category": "Varn",
        "icon": "$(graph)"
      },
      {
        "command": "varn.diffBytecode",
        "title": "Diff Source vs Bytecode",
        "category": "Varn",
        "icon": "$(diff)"
      },
      {
        "command": "varn.openStdModule",
        "title": "Open Stdlib Module (readonly)",
        "category": "Varn",
        "icon": "$(library)"
      },
      {
        "command": "varn.runMain",
        "title": "Run Main Function",
        "category": "Varn",
        "icon": "$(play)"
      },
      {
        "command": "varn.runTest",
        "title": "Run Test",
        "category": "Varn",
        "icon": "$(beaker)"
      },
      {
        "command": "varn.runBenchmark",
        "title": "Run Benchmark",
        "category": "Varn",
        "icon": "$(dashboard)"
      }
    ],
    "problemMatchers": [
      {
        "name": "varn",
        "owner": "varn",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "varn",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Varn task to execute (build, check, test)"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "Varn.runFile",
        "key": "ctrl+f5",
        "when": "resourceLangId == varn && !inDebugMode"
      },
      {
        "command": "workbench.action.debug.start",
        "key": "f5",
        "when": "resourceLangId == varn && !inDebugMode && !debuggersAvailable"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "Varn.runFile",
          "when": "resourceLangId == varn",
          "group": "navigation@1"
        },
        {
          "command": "Varn.runFileInTerminal",
          "when": "resourceLangId == varn",
          "group": "navigation@2"
        },
        {
          "command": "Varn.checkFile",
          "when": "resourceLangId == varn",
          "group": "navigation@3"
        },
        {
          "command": "Varn.buildFile",
          "when": "resourceLangId == varn",
          "group": "navigation@4"
        },
        {
          "command": "Varn.runWithPhases",
          "when": "resourceLangId == varn",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "Varn.runFile",
          "when": "resourceLangId == varn",
          "group": "Varn@1"
        },
        {
          "command": "Varn.runFileInTerminal",
          "when": "resourceLangId == varn",
          "group": "Varn@2"
        },
        {
          "command": "Varn.checkFile",
          "when": "resourceLangId == varn",
          "group": "Varn@3"
        },
        {
          "command": "Varn.buildFile",
          "when": "resourceLangId == varn",
          "group": "Varn@4"
        },
        {
          "command": "Varn.showBytecode",
          "when": "resourceLangId == varn",
          "group": "Varn@5"
        },
        {
          "command": "Varn.showAst",
          "when": "resourceLangId == varn",
          "group": "Varn@6"
        },
        {
          "command": "Varn.doctor",
          "when": "resourceLangId == varn",
          "group": "Varn@7"
        },
        {
          "command": "varn.openVisualInspector",
          "when": "resourceLangId == varn",
          "group": "Varn@8"
        }
      ],
      "editor/title": [
        {
          "command": "varn.openVisualInspector",
          "when": "resourceLangId == varn",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "Varn.runFile",
          "when": "resourceExtname == .vn",
          "group": "Varn@1"
        },
        {
          "command": "Varn.runFileInTerminal",
          "when": "resourceExtname == .vn",
          "group": "Varn@2"
        },
        {
          "command": "Varn.checkFile",
          "when": "resourceExtname == .vn",
          "group": "Varn@3"
        },
        {
          "command": "Varn.buildFile",
          "when": "resourceExtname == .vn",
          "group": "Varn@4"
        },
        {
          "command": "Varn.benchFile",
          "when": "resourceExtname == .vn",
          "group": "Varn@5"
        }
      ],
      "commandPalette": [
        {
          "command": "Varn.selectEditorRange",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Varn",
      "properties": {
        "Varn.cli.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Varn binary. Leave empty to auto-detect from varn_HOME/bin, workspace target/{release,debug}, or PATH."
        },
        "Varn.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints for types and parameter names."
        },
        "Varn.run.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Pass --verbose to Varn when running files."
        },
        "Varn.run.debugPhases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tokens",
              "ast",
              "bytecode",
              "symbols",
              "binds",
              "modules",
              "types",
              "errors",
              "trace",
              "calls",
              "consts",
              "scope",
              "graph"
            ]
          },
          "default": [],
          "description": "Default debug phases to enable when running files."
        },
        "Varn.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Varn CodeLens actions (Run, Bench, Disasm, AST) at the top of .Varn files."
        },
        "Varn.hotReload.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reload the extension when source files change (requires restart for package.json contributes changes)."
        },
        "Varn.hotReload.watchBinary": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restart the Language Server when the resolved `vn` binary is rebuilt."
        },
        "Varn.buildMode": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "default": "release",
          "description": "Preferred build mode for Varn binaries when auto-detecting from the workspace target directory."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.109.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
