{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["extension.*", "src/**/*"]
}
