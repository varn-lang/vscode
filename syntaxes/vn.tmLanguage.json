{
	"name": "Varn",
	"scopeName": "source.vn",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#shebang" },
		{ "include": "#hover-label" },
		{ "include": "#import-declaration" },
		{ "include": "#export-modifier" },
		{ "include": "#decorator" },
		{ "include": "#function-declaration" },
		{ "include": "#namespace-declaration" },
		{ "include": "#extension-declaration" },
		{ "include": "#class-declaration" },
		{ "include": "#type-alias" },
		{ "include": "#destructuring-declaration" },
		{ "include": "#variable-declaration" },
		{ "include": "#expression" }
	],
	"repository": {

		"___________________COMMENTS___________________": { "comment": "section marker" },

		"shebang": {
			"name": "comment.line.shebang.vn",
			"match": "\\A#!.*$"
		},

		"comment": {
			"patterns": [
				{
					"name": "comment.block.documentation.vn",
					"begin": "/\\*\\*",
					"end": "\\*/",
					"patterns": [ { "include": "#comment-tag" } ]
				},
				{
					"name": "comment.block.vn",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "comment.line.double-slash.vn",
					"begin": "//",
					"end": "(?=$)",
					"patterns": [ { "include": "#comment-tag" } ]
				}
			]
		},
		"comment-tag": {
			"match": "\\b(TODO|FIXME|HACK|NOTE|XXX|BUG)\\b",
			"name": "keyword.codetag.notation.vn"
		},

		"hover-label": {
			"comment": "Pseudo-labels emitted only in LSP hover signatures, e.g. (property), (method). Rendered muted like an annotation.",
			"match": "^\\s*(\\()(type parameter|enum member|property|method|param|this|getter|setter|constructor|destructor|namespace|interface|struct|class|enum|module|extension|var|let|const|prop)(\\))(?=\\s+[_$[:alpha:]])",
			"captures": {
				"1": { "name": "punctuation.definition.label.vn" },
				"2": { "name": "comment.label.hover.vn" },
				"3": { "name": "punctuation.definition.label.vn" }
			}
		},

		"___________________IMPORTS___________________": { "comment": "section marker" },

		"import-declaration": {
			"begin": "(?<![._$[:alnum:]])(import)(?![_$[:alnum:]]|\\s*[.(])",
			"beginCaptures": {
				"1": { "name": "keyword.control.import.vn" }
			},
			"end": "(?<=[\"'])|(?=;)",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#string" },
				{
					"match": "(?<![._$[:alnum:]])(from|as)(?![_$[:alnum:]])",
					"name": "keyword.control.import.vn"
				},
				{ "match": "\\*", "name": "variable.language.wildcard.vn" },
				{ "match": "[_$[:alpha:]][_$[:alnum:]]*", "name": "variable.other.readwrite.alias.vn" },
				{ "include": "#punctuation" }
			]
		},

		"export-modifier": {
			"match": "(?<![._$[:alnum:]])(export)(?![_$[:alnum:]])",
			"name": "keyword.control.export.vn"
		},

		"___________________DECORATORS___________________": { "comment": "section marker" },

		"decorator": {
			"match": "(@)([_$[:alpha:]][_$[:alnum:]]*)",
			"captures": {
				"1": { "name": "punctuation.decorator.vn" },
				"2": { "name": "entity.name.function.decorator.vn" }
			}
		},

		"___________________FUNCTIONS___________________": { "comment": "section marker" },

		"function-declaration": {
			"name": "meta.function.declaration.vn",
			"comment": "`function`, `async function`, `function*` (generator) and `async function*`.",
			"begin": "(?<![._$[:alnum:]])(?:(async)\\s+)?(function)\\b(\\s*\\*)?(?:\\s+([_$[:alpha:]][_$[:alnum:]]*))?",
			"beginCaptures": {
				"1": { "name": "storage.modifier.async.vn" },
				"2": { "name": "storage.type.function.vn" },
				"3": { "name": "keyword.generator.asterisk.vn" },
				"4": { "name": "entity.name.function.vn" }
			},
			"end": "(?=[{;])|(?:(?<=[A-Za-z0-9_$\\]>)}\"'`])|(?<=[A-Za-z0-9_$\\]>)]\\?))(?<!=>)(?=\\s*(?://.*)?$)",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{ "include": "#parameter-list" },
				{ "include": "#type-annotation" },
				{ "match": "=>", "name": "keyword.operator.type.arrow.vn" },
				{ "include": "#type" }
			]
		},

		"___________________TYPES (CLASS/STRUCT/ETC)___________________": { "comment": "section marker" },

		"class-declaration": {
			"name": "meta.class.declaration.vn",
			"begin": "(?<![._$[:alnum:]])(?:(abstract|declare)\\s+)?(class|struct|interface|enum)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
			"beginCaptures": {
				"1": { "name": "storage.modifier.vn" },
				"2": { "name": "storage.type.vn" },
				"3": { "name": "entity.name.type.vn" }
			},
			"end": "(?<=\\})|(?=[;])",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{ "include": "#parameter-list" },
				{ "include": "#heritage" },
				{ "include": "#class-body" }
			]
		},

		"namespace-declaration": {
			"comment": "`namespace A.B { ... }` and `module m { ... }`: the body holds statements, not class members.",
			"name": "meta.namespace.declaration.vn",
			"begin": "(?<![._$[:alnum:]])(?:(declare)\\s+)?(namespace|module)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*(?:\\.[_$[:alpha:]][_$[:alnum:]]*)*)",
			"beginCaptures": {
				"1": { "name": "storage.modifier.vn" },
				"2": { "name": "storage.type.vn" },
				"3": { "name": "entity.name.namespace.vn" }
			},
			"end": "(?<=\\})|(?=;)",
			"patterns": [
				{ "include": "#comment" },
				{
					"begin": "\\{",
					"beginCaptures": { "0": { "name": "punctuation.section.namespace-body.begin.vn" } },
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.section.namespace-body.end.vn" } },
					"patterns": [ { "include": "#block-statements" } ]
				}
			]
		},

		"extension-declaration": {
			"comment": "`extension<T> on Type { ... }`.",
			"name": "meta.extension.declaration.vn",
			"begin": "(?<![._$[:alnum:]])(extension)(?![_$[:alnum:]])(?=\\s*(?:<|on\\b))",
			"beginCaptures": {
				"1": { "name": "storage.type.vn" }
			},
			"end": "(?<=\\})|(?=;)",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{ "include": "#heritage" },
				{ "include": "#class-body" }
			]
		},

		"heritage": {
			"begin": "(?<![._$[:alnum:]])(extends|implements|on)(?![_$[:alnum:]])",
			"beginCaptures": {
				"1": { "name": "storage.modifier.vn" }
			},
			"end": "(?=[{=;])",
			"patterns": [
				{ "include": "#comment" },
				{ "match": "(?<![._$[:alnum:]])(extends|implements)(?![_$[:alnum:]])", "name": "storage.modifier.vn" },
				{ "match": ",", "name": "punctuation.separator.comma.vn" },
				{ "include": "#type" }
			]
		},

		"class-body": {
			"begin": "\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.section.class-body.begin.vn" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.section.class-body.end.vn" }
			},
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#decorator" },
				{ "include": "#storage-modifier" },
				{ "include": "#field-initializer" },
				{ "include": "#enum-member" },
				{ "include": "#constructor-declaration" },
				{ "include": "#method-declaration" },
				{ "include": "#property-declaration" },
				{ "include": "#type-annotation" },
				{ "include": "#block" },
				{ "include": "#expression" }
			]
		},

		"field-initializer": {
			"comment": "`name: Type = expression` inside a class body: the value is an expression, not a method.",
			"begin": "=(?!>)",
			"beginCaptures": { "0": { "name": "keyword.operator.assignment.vn" } },
			"end": "(?=;)|(?=})|(?<=[A-Za-z0-9_$\\]>)}\"'`])(?<!=>)(?=\\s*(?://.*)?$)",
			"patterns": [
				{ "include": "#nested-groups" },
				{ "include": "#expression" }
			]
		},

		"constructor-declaration": {
			"name": "meta.method.declaration.vn",
			"comment": "`constructor(...)` and `destructor()` are keywords, not method names.",
			"begin": "(?<![._$[:alnum:]])(constructor|destructor)\\s*(?=[(<])",
			"beginCaptures": {
				"1": { "name": "storage.type.function.constructor.vn" }
			},
			"end": "(?=[{;,}])|(?:(?<=[A-Za-z0-9_$\\]>)}\"'`])|(?<=[A-Za-z0-9_$\\]>)]\\?))(?<!=>)(?=\\s*(?://.*)?$)",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{ "include": "#parameter-list" },
				{ "include": "#type-annotation" },
				{ "match": "=>", "name": "keyword.operator.type.arrow.vn" },
				{ "include": "#type" }
			]
		},

		"method-declaration": {
			"name": "meta.method.declaration.vn",
			"comment": "Class/interface member with a parameter list. Optional leading `*` for generator methods.",
			"begin": "(\\*\\s*)?([_$[:alpha:]][_$[:alnum:]]*)\\s*(?=[(<])",
			"beginCaptures": {
				"1": { "name": "keyword.generator.asterisk.vn" },
				"2": { "name": "entity.name.function.vn" }
			},
			"end": "(?=[{;,}])|(?:(?<=[A-Za-z0-9_$\\]>)}\"'`])|(?<=[A-Za-z0-9_$\\]>)]\\?))(?<!=>)(?=\\s*(?://.*)?$)",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{ "include": "#parameter-list" },
				{ "include": "#type-annotation" },
				{ "match": "=>", "name": "keyword.operator.type.arrow.vn" },
				{ "include": "#type" }
			]
		},

		"property-declaration": {
			"comment": "Field with a type annotation: `name: T` / `name?: T`.",
			"match": "([_$[:alpha:]][_$[:alnum:]]*)\\s*(\\?)?\\s*(?=:)",
			"captures": {
				"1": { "name": "variable.other.property.vn" },
				"2": { "name": "keyword.operator.optional.vn" }
			}
		},

		"enum-member": {
			"comment": "Bare enum member with no type annotation (e.g. `North,` `GET = 0`). Capitalization-agnostic identifier directly followed by `,`, `=` or the closing brace.",
			"match": "(?<![._$[:alnum:]])([_$[:alpha:]][_$[:alnum:]]*)\\s*(?=[,=}])",
			"name": "variable.other.enummember.vn"
		},

		"type-alias": {
			"begin": "(?<![._$[:alnum:]])(type)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
			"beginCaptures": {
				"1": { "name": "storage.type.vn" },
				"2": { "name": "entity.name.type.vn" }
			},
			"end": "(?=;)|(?=\\})|(?=^(?!\\s*[|&])\\s*\\S)",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{
					"comment": "The type itself. It ends at the end of the line once the type is complete; a following line that starts with | or & continues it.",
					"begin": "=(?!>)",
					"beginCaptures": { "0": { "name": "keyword.operator.assignment.vn" } },
					"end": "(?=;)|(?:(?<=[A-Za-z0-9_$\\]>)}\"'`])|(?<=[A-Za-z0-9_$\\]>)]\\?))(?<!=>)(?=\\s*(?://.*)?$)",
					"patterns": [ { "include": "#type" } ]
				},
				{ "include": "#type" }
			]
		},

		"___________________DECLARATIONS (VAR/CONST/LET)___________________": { "comment": "section marker" },

		"destructuring-declaration": {
			"name": "meta.binding.destructuring.vn",
			"begin": "(?<![._$[:alnum:]])(const|let|var|using)(?![_$[:alnum:]])(?=\\s*[{\\[(])",
			"beginCaptures": {
				"1": { "name": "storage.type.vn" }
			},
			"end": "(?<=[}\\])])",
			"patterns": [ { "include": "#binding-pattern" } ]
		},
		"binding-pattern": {
			"patterns": [
				{ "include": "#comment" },
				{
					"name": "meta.binding.object.vn",
					"begin": "\\{",
					"beginCaptures": { "0": { "name": "punctuation.definition.binding.begin.vn" } },
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.definition.binding.end.vn" } },
					"patterns": [ { "include": "#binding-contents" } ]
				},
				{
					"name": "meta.binding.array.vn",
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "punctuation.definition.binding.begin.vn" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "punctuation.definition.binding.end.vn" } },
					"patterns": [ { "include": "#binding-contents" } ]
				},
				{
					"name": "meta.binding.tuple.vn",
					"begin": "\\(",
					"beginCaptures": { "0": { "name": "punctuation.definition.binding.begin.vn" } },
					"end": "\\)",
					"endCaptures": { "0": { "name": "punctuation.definition.binding.end.vn" } },
					"patterns": [ { "include": "#binding-contents" } ]
				}
			]
		},
		"binding-contents": {
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#binding-pattern" },
				{ "match": "\\.\\.\\.", "name": "keyword.operator.rest.vn" },
				{
					"match": "([_$[:alpha:]][_$[:alnum:]]*)\\s*(:)",
					"captures": {
						"1": { "name": "variable.other.property.vn" },
						"2": { "name": "punctuation.separator.binding.vn" }
					}
				},
				{
					"begin": "=",
					"beginCaptures": { "0": { "name": "keyword.operator.assignment.vn" } },
					"end": "(?=[,}\\]])",
					"patterns": [ { "include": "#expression" } ]
				},
				{ "match": "[_$[:alpha:]][_$[:alnum:]]*", "name": "variable.other.readwrite.vn" },
				{ "match": ",", "name": "punctuation.separator.comma.vn" }
			]
		},

		"variable-declaration": {
			"patterns": [
				{
					"name": "meta.var.expr.const.vn",
					"begin": "(?<![._$[:alnum:]])(const)(?![_$[:alnum:]])",
					"beginCaptures": {
						"1": { "name": "storage.type.vn" }
					},
					"end": "(?=[;=},)]|\\b(of|in)\\b)",
					"patterns": [
						{ "include": "#comment" },
						{ "include": "#variable-type-annotation" },
						{
							"match": "([_$[:alpha:]][_$[:alnum:]]*)",
							"name": "variable.other.constant.vn"
						}
					]
				},
				{
					"name": "meta.var.expr.mut.vn",
					"begin": "(?<![._$[:alnum:]])(let|var|using)(?![_$[:alnum:]])",
					"beginCaptures": {
						"1": { "name": "storage.type.vn" }
					},
					"end": "(?=[;=},)]|\\b(of|in)\\b)",
					"patterns": [
						{ "include": "#comment" },
						{ "include": "#variable-type-annotation" },
						{
							"match": "([_$[:alpha:]][_$[:alnum:]]*)",
							"name": "variable.other.readwrite.vn"
						}
					]
				}
			]
		},

		"___________________PARAMETERS & TYPE ANNOTATIONS___________________": { "comment": "section marker" },

		"parameter-default": {
			"comment": "The default value of a parameter is an expression, up to the comma or the closing parenthesis.",
			"begin": "=(?!>)",
			"beginCaptures": { "0": { "name": "keyword.operator.assignment.vn" } },
			"end": "(?=[,)])",
			"patterns": [
				{ "include": "#nested-groups" },
				{ "include": "#expression" }
			]
		},

		"nested-groups": {
			"comment": "Balanced (), [] and {} inside an expression, so a comma in them does not end the enclosing rule.",
			"patterns": [
				{
					"begin": "\\(",
					"beginCaptures": { "0": { "name": "punctuation.section.parens.vn" } },
					"end": "\\)",
					"endCaptures": { "0": { "name": "punctuation.section.parens.vn" } },
					"patterns": [
						{ "include": "#nested-groups" },
						{ "include": "#expression" },
						{ "match": ",", "name": "punctuation.separator.comma.vn" }
					]
				},
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "punctuation.section.brackets.vn" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "punctuation.section.brackets.vn" } },
					"patterns": [
						{ "include": "#nested-groups" },
						{ "include": "#expression" },
						{ "match": ",", "name": "punctuation.separator.comma.vn" }
					]
				},
				{
					"begin": "\\{",
					"beginCaptures": { "0": { "name": "punctuation.section.braces.vn" } },
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.section.braces.vn" } },
					"patterns": [ { "include": "#block-statements" } ]
				}
			]
		},

		"parameter-list": {
			"begin": "\\(",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.parameters.begin.vn" }
			},
			"end": "\\)",
			"endCaptures": {
				"0": { "name": "punctuation.definition.parameters.end.vn" }
			},
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#decorator" },
				{ "include": "#storage-modifier" },
				{ "match": "\\.\\.\\.", "name": "keyword.operator.rest.vn" },
				{
					"match": "([_$[:alpha:]][_$[:alnum:]]*)\\s*(\\?)?\\s*(?=:)",
					"captures": {
						"1": { "name": "variable.parameter.vn" },
						"2": { "name": "keyword.operator.optional.vn" }
					}
				},
				{
					"match": "([_$[:alpha:]][_$[:alnum:]]*)\\s*(?=[,)=])",
					"name": "variable.parameter.vn"
				},
				{ "include": "#parameter-default" },
				{
					"comment": "The arrow of a function type used as a parameter type: `cb: (x: T) => void`.",
					"begin": "=>",
					"beginCaptures": { "0": { "name": "keyword.operator.type.arrow.vn" } },
					"end": "(?=[,)])",
					"patterns": [ { "include": "#type" } ]
				},
				{ "include": "#variable-type-annotation" },
				{ "include": "#constant" },
				{ "include": "#string" },
				{ "include": "#number" },
				{ "include": "#operator" },
				{ "include": "#punctuation" }
			]
		},

		"variable-type-annotation": {
			"comment": "The type of a const/let/var: unlike a return type, a { here starts an object type, not a body.",
			"begin": "(:)",
			"beginCaptures": { "1": { "name": "punctuation.separator.annotation.vn" } },
			"end": "(?=[,)=;}]|=>)|(?:(?<=[A-Za-z0-9_$\\]>)}\"'`])|(?<=[A-Za-z0-9_$\\]>)]\\?))(?<!=>)(?=\\s*(?://.*)?$)",
			"patterns": [ { "include": "#type" } ]
		},

		"type-annotation": {
			"begin": "(:)",
			"beginCaptures": {
				"1": { "name": "punctuation.separator.annotation.vn" }
			},
			"end": "(?=[,)=;{}]|=>)|(?:(?<=[A-Za-z0-9_$\\]>)}\"'`])|(?<=[A-Za-z0-9_$\\]>)]\\?))(?<!=>)(?=\\s*(?://.*)?$)",
			"patterns": [ { "include": "#type" } ]
		},

		"___________________TYPE EXPRESSIONS___________________": { "comment": "section marker" },

		"type": {
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#builtin-type-primitive" },
				{ "include": "#builtin-type-object" },
				{
					"match": "(?<![._$[:alnum:]])(extends|keyof|infer|typeof|readonly|in|is)(?![_$[:alnum:]])",
					"name": "keyword.operator.type.vn"
				},
				{ "include": "#string" },
				{ "include": "#number" },
				{ "include": "#type-object" },
				{ "include": "#type-brackets" },
				{ "include": "#type-parens" },
				{ "include": "#generic-arguments" },
				{ "match": ":", "name": "keyword.operator.ternary.vn" },
				{ "match": "-(?=\\s*[0-9])", "name": "keyword.operator.arithmetic.vn" },
				{ "match": "\\|", "name": "keyword.operator.type.union.vn" },
				{ "match": "&", "name": "keyword.operator.type.intersection.vn" },
				{ "match": "\\?", "name": "keyword.operator.type.optional.vn" },
				{ "match": "\\[\\]", "name": "punctuation.definition.array.vn" },
				{ "match": "=>", "name": "keyword.operator.type.arrow.vn" },
				{ "include": "#constant" },
				{ "include": "#variable-language" },
				{ "match": "[_$[:alpha:]][_$[:alnum:]]*", "name": "entity.name.type.vn" },
				{ "match": "[,.]", "name": "punctuation.type.vn" }
			]
		},

		"type-object": {
			"comment": "Object type literal and mapped type body: `{ a: int, b?: str }`, `{ [K in keyof T]: T[K] }`.",
			"name": "meta.type.object.vn",
			"begin": "\\{",
			"beginCaptures": { "0": { "name": "punctuation.definition.type.object.begin.vn" } },
			"end": "\\}",
			"endCaptures": { "0": { "name": "punctuation.definition.type.object.end.vn" } },
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#type-member" },
				{ "include": "#type" },
				{ "match": "[;,]", "name": "punctuation.separator.type.vn" }
			]
		},

		"type-brackets": {
			"comment": "Tuple, indexed access, index signature and mapped-type key: `[int, str]`, `T[K]`, `[K in keyof T]`.",
			"begin": "\\[",
			"beginCaptures": { "0": { "name": "punctuation.definition.type.brackets.begin.vn" } },
			"end": "\\]",
			"endCaptures": { "0": { "name": "punctuation.definition.type.brackets.end.vn" } },
			"patterns": [
				{ "include": "#type-member" },
				{ "include": "#type" }
			]
		},

		"type-parens": {
			"comment": "Parenthesized type and function type parameters: `(a: int, ...rest: str[]) => void`.",
			"begin": "\\(",
			"beginCaptures": { "0": { "name": "punctuation.definition.type.parens.begin.vn" } },
			"end": "\\)",
			"endCaptures": { "0": { "name": "punctuation.definition.type.parens.end.vn" } },
			"patterns": [
				{ "match": "\\.\\.\\.", "name": "keyword.operator.spread.vn" },
				{ "include": "#type-member" },
				{ "include": "#type" }
			]
		},

		"type-member": {
			"comment": "A named member or parameter inside a type: `name?: Type`, `readonly id: int`.",
			"begin": "(?:(readonly)\\s+)?([_$[:alpha:]][_$[:alnum:]]*)(\\?)?\\s*(:)",
			"beginCaptures": {
				"1": { "name": "keyword.operator.type.vn" },
				"2": { "name": "variable.other.property.vn" },
				"3": { "name": "keyword.operator.type.optional.vn" },
				"4": { "name": "punctuation.separator.annotation.vn" }
			},
			"end": "(?=[;,})\\]])",
			"patterns": [ { "include": "#type" } ]
		},

		"generic-parameters": {
			"comment": "Declaration-site type parameter list, e.g. `<T, U extends X = Y>`.",
			"begin": "(?<=[_$[:alnum:]])(<)(?=[_$[:alpha:]\\s])",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.typeparameters.begin.vn" }
			},
			"end": ">",
			"endCaptures": {
				"0": { "name": "punctuation.definition.typeparameters.end.vn" }
			},
			"patterns": [
				{ "match": "=(?!>)", "name": "keyword.operator.assignment.vn" },
				{ "include": "#type" },
				{ "include": "#punctuation-comma" }
			]
		},

		"generic-arguments": {
			"comment": "Use-site type argument list, e.g. `Box<int>`, `identity<str>(...)`.",
			"begin": "(?<=[_$[:alnum:]])(<)(?=[_$[:alpha:](\\[{])",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.typeparameters.begin.vn" }
			},
			"end": ">",
			"endCaptures": {
				"0": { "name": "punctuation.definition.typeparameters.end.vn" }
			},
			"patterns": [
				{ "include": "#type" },
				{ "include": "#punctuation-comma" }
			]
		},

		"builtin-type-primitive": {
			"comment": "Scalar primitives — mirror of varn-base TypeTag scalar tags.",
			"name": "support.type.primitive.vn entity.name.type.primitive.vn",
			"match": "(?<![._$[:alnum:]])(int|float|bool|str|char|bigint|decimal|symbol|void|never|dynamic)(?![_$[:alnum:]])"
		},

		"builtin-type-object": {
			"comment": "Built-in reference/container & error types — mirror of varn-base TypeTag reference tags (plus stdlib Result).",
			"name": "support.class.builtin.vn entity.name.type.class.vn",
			"match": "(?<![._$[:alnum:]])(Object|Array|Map|Set|Tuple|Generator|AsyncGenerator|Iterator|AsyncIterator|Range|Task|Result|Symbol|Error|TypeError|RangeError)(?![_$[:alnum:]])"
		},

		"___________________KEYWORDS___________________": { "comment": "section marker" },

		"control-keyword": {
			"comment": "keyword_kind control-flow & resource keywords.",
			"name": "keyword.control.vn",
			"match": "(?<![._$[:alnum:]])(if|else|switch|case|default|while|for|do|break|continue|return|throw|try|catch|finally|with|using|match|yield|await)(?![_$[:alnum:]])"
		},

		"storage-modifier": {
			"comment": "keyword_kind modifiers usable on declarations and members.",
			"name": "storage.modifier.vn",
			"match": "(?<![._$[:alnum:]])(public|private|protected|static|abstract|override|readonly|declare|native|async|get|set)(?![_$[:alnum:]])"
		},

		"new-expression": {
			"match": "(?<![._$[:alnum:]])(new)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
			"captures": {
				"1": { "name": "keyword.operator.new.vn" },
				"2": { "name": "entity.name.type.vn" }
			}
		},

		"word-operator": {
			"comment": "keyword_kind operator-like keywords used in expressions.",
			"name": "keyword.operator.expression.vn",
			"match": "(?<![._$[:alnum:]])(typeof|instanceof|delete|is|in|of|as)(?![_$[:alnum:]])"
		},

		"variable-language": {
			"patterns": [
				{
					"match": "(?<![._$[:alnum:]])(import)\\s*(\\.)\\s*(meta)(?![_$[:alnum:]])",
					"captures": {
						"1": { "name": "keyword.control.import.vn" },
						"2": { "name": "punctuation.accessor.vn" },
						"3": { "name": "variable.language.meta.vn" }
					}
				},
				{
					"name": "variable.language.vn",
					"match": "(?<![._$[:alnum:]])(this|super)(?![_$[:alnum:]])"
				}
			]
		},

		"constant": {
			"name": "constant.language.vn",
			"match": "(?<![._$[:alnum:]])(true|false|null)(?![_$[:alnum:]])"
		},

		"___________________LITERALS___________________": { "comment": "section marker" },

		"string": {
			"patterns": [
				{
					"comment": "Raw string: no escapes, may span lines.",
					"name": "string.quoted.triple.vn",
					"begin": "\"\"\"",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vn" } },
					"end": "\"\"\"",
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.vn" } }
				},
				{
					"name": "string.quoted.double.vn",
					"begin": "\"",
					"end": "\"|(?=$)",
					"patterns": [ { "include": "#string-escape" } ]
				},
				{
					"name": "string.quoted.single.vn",
					"begin": "'",
					"end": "'|(?=$)",
					"patterns": [ { "include": "#string-escape" } ]
				},
				{
					"name": "string.template.vn",
					"begin": "`",
					"end": "`",
					"patterns": [
						{ "include": "#string-escape" },
						{ "include": "#template-substitution" }
					]
				}
			]
		},
		"string-escape": {
			"name": "constant.character.escape.vn",
			"match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)"
		},
		"template-substitution": {
			"name": "meta.template.expression.vn",
			"begin": "\\$\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.template-expression.begin.vn" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.template-expression.end.vn" }
			},
			"patterns": [ { "include": "#expression" } ]
		},

		"regex": {
			"comment": "Regex literal. The lexer allows it unless the previous token is an identifier, literal, `)`, `]`, `}`, `++` or `--`; `/=` is never a regex.",
			"match": "(?<=^|[=(,:\\[&|?{;]|=>|\\breturn|\\btypeof|\\bcase)\\s*(/)(?![/*=])((?:\\\\.|\\[(?:\\\\.|[^\\]\\\\])*\\]|[^/\\\\\\[\\n])+)(/)([a-z]*)",
			"captures": {
				"1": { "name": "punctuation.definition.string.begin.vn" },
				"2": { "name": "string.regexp.vn" },
				"3": { "name": "punctuation.definition.string.end.vn" },
				"4": { "name": "keyword.other.regexp-flag.vn" }
			}
		},

		"number": {
			"comment": "Suffixes: `n` = bigint, `d` = decimal. `_` digit separators allowed.",
			"patterns": [
				{ "name": "constant.numeric.hex.vn", "match": "\\b0[xX][0-9a-fA-F_]+n?\\b" },
				{ "name": "constant.numeric.octal.vn", "match": "\\b0[oO][0-7_]+n?\\b" },
				{ "name": "constant.numeric.binary.vn", "match": "\\b0[bB][01_]+n?\\b" },
				{ "name": "constant.numeric.decimal.vn", "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?[nd]?\\b" }
			]
		},

		"___________________EXPRESSIONS___________________": { "comment": "section marker" },

		"block": {
			"begin": "\\{",
			"beginCaptures": { "0": { "name": "punctuation.section.block.begin.vn" } },
			"end": "\\}",
			"endCaptures": { "0": { "name": "punctuation.section.block.end.vn" } },
			"patterns": [
				{ "include": "#block-statements" }
			]
		},
		"block-statements": {
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#export-modifier" },
				{ "include": "#function-declaration" },
				{ "include": "#namespace-declaration" },
				{ "include": "#extension-declaration" },
				{ "include": "#class-declaration" },
				{ "include": "#type-alias" },
				{ "include": "#destructuring-declaration" },
				{ "include": "#variable-declaration" },
				{ "include": "#block" },
				{ "include": "#expression" }
			]
		},

		"expression": {
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#decorator" },
				{ "include": "#reflection-access" },
				{ "include": "#anonymous-class" },
				{ "include": "#cast-expression" },
				{ "include": "#new-expression" },
				{ "include": "#word-operator" },
				{ "include": "#control-keyword" },
				{ "include": "#storage-modifier" },
				{ "include": "#variable-language" },
				{ "include": "#match-wildcard" },
				{ "include": "#constant" },
				{ "include": "#regex" },
				{ "include": "#string" },
				{ "include": "#number" },
				{ "include": "#object-key" },
				{ "include": "#generic-arguments" },
				{ "include": "#method-call" },
				{ "include": "#member-access" },
				{ "include": "#function-call" },
				{ "include": "#builtin-type-primitive" },
				{ "include": "#builtin-type-object" },
				{ "include": "#type-name-reference" },
				{ "include": "#operator" },
				{ "include": "#punctuation" },
				{ "include": "#variable-reference" }
			]
		},

		"reflection-access": {
			"comment": "`value::type`, `value::class`: the name after :: is a member, even when it is a keyword.",
			"match": "(::)\\s*([_$[:alpha:]][_$[:alnum:]]*)",
			"captures": {
				"1": { "name": "punctuation.accessor.namespace.vn" },
				"2": { "name": "variable.other.property.vn" }
			}
		},

		"anonymous-class": {
			"comment": "A class expression: `class { ... }`.",
			"name": "meta.class.declaration.vn",
			"begin": "(?<![._$[:alnum:]:])(class)(?=\\s*(?:\\{|extends\\b|implements\\b|<|\\())",
			"beginCaptures": { "1": { "name": "storage.type.vn" } },
			"end": "(?<=\\})",
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#generic-parameters" },
				{ "include": "#parameter-list" },
				{ "include": "#heritage" },
				{ "include": "#class-body" }
			]
		},

		"cast-expression": {
			"comment": "`expr as Type` cast. The `as` used in imports is handled inside #import-declaration.",
			"patterns": [
				{
					"match": "(?<![._$[:alnum:]])(as)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"1": { "name": "keyword.control.cast.vn" },
						"2": { "name": "entity.name.type.vn" }
					}
				},
				{
					"begin": "(?<![._$[:alnum:]])(as)(?![_$[:alnum:]])\\s*(?=\\{)",
					"beginCaptures": { "1": { "name": "keyword.control.cast.vn" } },
					"end": "(?<=\\})",
					"patterns": [ { "include": "#type-object" } ]
				}
			]
		},

		"match-wildcard": {
			"comment": "`_` placeholder in match arms, pipeline args and bindings (keyword_kind => PLACEHOLDER).",
			"match": "(?<![._$[:alnum:]])_(?![_$[:alnum:]])",
			"name": "constant.language.wildcard.vn"
		},

		"object-key": {
			"comment": "Object-literal key or named call argument: `key:` written without a space before the colon (so ternary `a : b` is not matched).",
			"match": "([_$[:alpha:]][_$[:alnum:]]*)(?=:)",
			"name": "variable.other.property.vn"
		},

		"method-call": {
			"match": "(?<=\\.)\\s*([_$[:alpha:]][_$[:alnum:]]*)\\s*(?=[(<])",
			"name": "entity.name.function.member.vn"
		},

		"member-access": {
			"match": "(?<=\\.)\\s*([_$[:alpha:]][_$[:alnum:]]*)",
			"name": "variable.other.property.vn"
		},

		"function-call": {
			"match": "([_$[:alpha:]][_$[:alnum:]]*)\\s*(?=[(<])",
			"name": "entity.name.function.call.vn"
		},

		"type-name-reference": {
			"comment": "Capitalized identifier used as a value (class/enum referenced as a value, e.g. Direction.North). Dotted members handled earlier.",
			"match": "(?<![._$[:alnum:]])([[:upper:]][_$[:alnum:]]*)(?![_$[:alnum:]])",
			"name": "entity.name.type.vn"
		},

		"variable-reference": {
			"comment": "Plain variable or identifier reference in an expression.",
			"match": "(?<![._$[:alnum:]])([_$[:alpha:]][_$[:alnum:]]*)(?![_$[:alnum:]])",
			"name": "variable.other.readwrite.vn"
		},

		"___________________OPERATORS & PUNCTUATION___________________": { "comment": "section marker" },

		"operator": {
			"patterns": [
				{ "name": "keyword.operator.arrow.vn", "match": "=>|->|\\|>" },
				{ "name": "keyword.operator.range.vn", "match": "\\.\\.=|\\.\\.\\.|\\.\\." },
				{ "name": "keyword.operator.comparison.vn", "match": "===|!==|==|!=|<=|>=" },
				{ "name": "keyword.operator.assignment.vn", "match": ">>>=|<<=|>>=|\\*\\*=|&&=|\\|\\|=|\\?\\?=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=" },
				{ "name": "keyword.operator.arithmetic.vn", "match": "\\+\\+|--|\\*\\*|\\+|-|\\*|/|%" },
				{ "name": "keyword.operator.logical.vn", "match": "&&|\\|\\||!" },
				{ "name": "keyword.operator.bitwise.vn", "match": "<<|>>>|>>|&|\\||\\^|~|<|>" },
				{ "name": "keyword.operator.ternary.vn", "match": "\\?\\?|\\?\\.|\\?" }
			]
		},

		"punctuation": {
			"patterns": [
				{ "name": "punctuation.accessor.optional.vn", "match": "\\?\\." },
				{ "name": "punctuation.accessor.namespace.vn", "match": "::" },
				{ "name": "punctuation.accessor.vn", "match": "\\." },
				{ "name": "punctuation.terminator.statement.vn", "match": ";" },
				{ "name": "punctuation.separator.comma.vn", "match": "," },
				{ "name": "punctuation.separator.colon.vn", "match": ":" },
				{ "name": "punctuation.section.braces.vn", "match": "[{}]" },
				{ "name": "punctuation.section.brackets.vn", "match": "[\\[\\]]" },
				{ "name": "punctuation.section.parens.vn", "match": "[()]" }
			]
		},

		"punctuation-comma": {
			"name": "punctuation.separator.comma.vn",
			"match": ","
		}
	}
}
